# Git metadata - not needed inside the container
.git
.gitignore

# Build output folders - Docker will produce its own inside the container
**/bin/
**/obj/

# Visual Studio files
**/*.user
**/.vs/
*.suo

# Test projects - not needed to run the API
tests/

# Docker files themselves
**/Dockerfile
docker-compose*.yml

# Environment-specific settings (use environment variables or secrets in production)
**/appsettings.Development.json
